# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-mock-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# playwright e2e (fully mocked — see e2e/README.md; no real login/session, so
# there's no .auth/ directory anymore)
/e2e-report/
/test-results/
/playwright-report/
/visual-snapshots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: personal settings stay local; .claude/settings.json is shared
.claude/settings.local.json
